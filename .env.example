# Copy to .env and fill in. All values are git-ignored.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Main Vertex AI Agent Engine (Memory Bank) used by the app and evals/eval_memory_bank.py
VERTEX_AGENT_ENGINE_ID=

# Scratch engines created by the eval scripts; each script's --create-engine flag writes the id here
CONSOL_FLASH_ENGINE_ID=
CONSOL_PRO_ENGINE_ID=
LONGMSG_ENGINE_ID=
CONV_ENGINE_ID=
LME_ENGINE_ID=
